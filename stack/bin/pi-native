#!/usr/bin/env bash
# Launch the pinned, local Pi input-ID build without changing the installed Pi.
set -euo pipefail

stack_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
manifest="$stack_root/pi-native.sha256"
if [[ ${1:-} == update ]]; then
    printf 'Immutable native deployment: prepare and verify a new release; never self-update this copy.\n' >&2
    exit 1
fi
build_id=$(sha256sum "$manifest" | cut -c1-16)
cli="$stack_root/.pi-native-$build_id/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
if [[ ! -f "$cli" ]]; then
    printf 'Native Pi is unavailable; run %s/bin/prepare-pi-native first.\n' "$stack_root" >&2
    exit 1
fi
# Drop inherited preloads (including the old external project bootstrap). The
# managed-project override is now copied inside the verified package instead.
unset NODE_OPTIONS NODE_PATH NODE_COMPILE_CACHE
export NODE_DISABLE_COMPILE_CACHE=1
python3 "$stack_root/../src/agent_comms/native_package.py" "${cli%/dist/cli.js}"
exec node --no-global-search-paths \
    --import "${cli%/cli.js}/agent-comms-import-fence.mjs" \
    --import "${cli%/cli.js}/agent-comms-project-bootstrap.mjs" "$cli" "$@"
