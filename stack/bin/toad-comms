#!/usr/bin/env bash
# Open the installed Comms workspace, optionally attaching a named thread.
set -euo pipefail

usage() {
    printf 'Usage: toad-comms [THREAD]\n       toad-comms --serve [THREAD] [TOAD SERVE OPTIONS...]\n\nOpen Agent Comms in Toad. Optionally open an existing thread.\nWith --serve, open the same session in a local web browser (toad serve).\n'
}

frontend=()
thread=""
if [[ "${1:-}" == --serve ]]; then
    shift
    frontend=(serve)
    if (( $# )) && [[ "$1" != -* ]]; then
        thread="$1"
        shift
    fi
    # toad serve owns its options, loopback binding and access token.
    frontend+=("$@" --)
else
    if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
        usage
        exit 0
    fi
    if (( $# > 1 )); then
        usage >&2
        exit 2
    fi
    thread="${1:-}"
fi

# Borrow the original publication resource before runtime/default selection.
# The open descriptor survives exec and retires with this exact client.
exec {route_lease}<"$HOME/.local/state/agent-comms"
if ! flock --shared --nonblock "$route_lease"; then
    printf 'Agent Comms publication is in progress; client not launched.\n' >&2
    exit 1
fi

runtime="${AGENT_COMMS_RUNTIME_ROOT:-}"
toad=""
if [[ -z "$runtime" ]]; then
    acp_launcher="${AGENT_COMMS_ACP_LAUNCHER:-$(command -v agent-comms-acp || true)}"
    if [[ -z "$acp_launcher" ]]; then
        acp_launcher="$HOME/.local/bin/agent-comms-acp"
    fi
    if [[ ! -x "$acp_launcher" ]]; then
        printf 'Installed agent-comms ACP launcher is unavailable: %s\n' "$acp_launcher" >&2
        exit 1
    fi
    runtime="$(dirname "$(readlink -f "$acp_launcher")")"
    toad="$runtime/toad"
else
    toad="$runtime/toad"
fi
python="$runtime/python"
if [[ ! -x "$python" || ! -x "$toad" ]]; then
    printf 'Installed Toad environment is unavailable: %s\n' "$runtime" >&2
    exit 1
fi

# The runtime discovers the active route. An inherited root from the old stack
# must not send Toad to a stale bus.
unset AGENT_COMMS_ROOT
unset PYTHONPATH
unset AGENT_COMMS_THREAD AGENT_COMMS_MANAGED PI_AGENT_ID PI_PARENT_ID PI_TASK PI_WORKTREE PI_PROMPT

project="$PWD"
session=()
if [[ -n "$thread" ]]; then
    # The CLI selects the root like every entry point; the launcher only reads its answer.
    if ! described="$("$runtime/agent-comms" thread --name "$thread" --no-pending)"; then
        printf '%s\n' "$described" >&2
        exit 1
    fi
    project="$("$python" -I -c 'import json, sys; print(json.loads(sys.argv[1])["worktree"])' "$described")"
    session=(--session "$thread")
fi
if [[ ! -d "$project" ]]; then
    printf 'Project directory is unavailable: %s\n' "$project" >&2
    exit 1
fi

exec "$toad" "${frontend[@]}" acp "$python -m agent_comms.acp" "$project" \
    --title 'Agent Comms' "${session[@]}"
