                    1,
                    Persistent(),
                    synthetic_summary,
                    settings=PiCompactionDecision(16384, 20000, True, False, OverflowCompactionReason, ()),
                    context_window=128000,
                )
    
        task = asyncio.create_task(owner(), name="actual-owner-turn")
