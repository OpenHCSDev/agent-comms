                )
            )
            preload = root / "local-only.cjs"
            preload.write_text(
                "const original=globalThis.fetch;globalThis.fetch=(url,...rest)=>{"
                "const link=url instanceof Request?url.url:String(url);"
                f"if(!link.startsWith('http://127.0.0.1:{server.server_port}/')) "
