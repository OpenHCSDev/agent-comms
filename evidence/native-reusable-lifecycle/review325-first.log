                        "created": 1,
                        "model": "z-ai/glm-5.3-flash",
                        "choices": [
                            {"index": 0, "delta": {"content": "RECEIVED"}, "finish_reason": "stop"}
                        ],
                        "usage": {"prompt_tokens": 100, "completion_tokens": 10, "total_tokens": 110},
                    }
                    self.wfile.write(f"data: {json.dumps(chunk)}\n\ndata: [DONE]\n\n".encode())
