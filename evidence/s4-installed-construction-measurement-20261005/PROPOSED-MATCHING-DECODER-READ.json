      "from pathlib import Path\nimport hashlib,io,json,subprocess,sys,zipfile,importlib.metadata as metadata\nimport agent_comms\nfrom agent_comms.field_codec import FieldCodec\nfrom publish_retained_summary import InstalledSource,ReviewedArtifact\nissued=Path(sys.argv[1]);expected=sys.argv[2]\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nassert sha(issued)==expected\ng=json.loads(issued.read_text());phase=g['proof'];output=Path(phase['receipt']);assert not output.exists()\nassert Path(sys.prefix)==Path(g['prefix'])\nsource=FieldCodec.decode(InstalledSource,json.loads(Path(g['installed_source']['path']).read_text()))\nassert sha(Path(g['installed_source']['path']))==g['installed_source']['sha256']\narchive=ReviewedArtifact(Path(g['candidate_wheel']['path']),g['candidate_wheel']['sha256'])\npackage=Path(agent_comms.__file__).resolve().parent\ncore=metadata.distribution('agent-comms');direct=json.loads(core.read_text('direct_url.json'))\nrevision=source.require_package('agent_comms',package,direct,(archive,))\noriginal=Path(g['original_wheel_source_proof']['path']);assert sha(original)==g['original_wheel_source_proof']['sha256']\nassets=json.loads(original.read_text())['assets'];assert len(assets)==source.files==355\nrequests=''.join(f\"{revision}:{a['source']}\\n\" for a in assets)\nblobs=io.BytesIO(subprocess.check_output(['git','cat-file','--batch'],input=requests.encode(),cwd=g['cwd']))\nsite=package.parent\nwith zipfile.ZipFile(archive.path) as wheel:\n for asset in assets:\n  header=blobs.readline().decode().split();assert header[1]=='blob'\n  data=blobs.read(int(header[2]));assert blobs.read(1)==b'\\n'\n  assert data==wheel.read(asset['member'])==(site/asset['member']).read_bytes(),asset['member']\n  assert hashlib.sha256(data).hexdigest()==asset['sha256'],asset['member']\n actual={p.relative_to(site).as_posix() for p in package.rglob('*') if p.is_file() and '__pycache__' not in p.parts}\n assert actual=={a['member'] for a in assets}\nfrom dataclasses import fields\nfrom agent_comms.turn_context import SystemLayerSegment,SegmentManifest\nassert 'source_spans' in {f.name for f in fields(SystemLayerSegment)}\nassert 'source_spans' in {f.name for f in fields(SegmentManifest)}\nversions={d.metadata['Name']:d.version for d in metadata.distributions()}\nassert versions==g['normal_distributions']\nmetadata_files=[p for d in site.glob('*.dist-info') for p in d.rglob('*') if p.is_file()];assert len(metadata_files)==69\nresult={'state':'PASS actual imported original676 Core decoder/source/origin equality; recorded input measurement not yet run',\n 'source':FieldCodec.encode(source),'source_head':revision,'assets':355,'Git_ZIP_installed_equal_noextras':True,\n 'SystemLayerSegment_source_spans_declared':True,'SegmentManifest_source_spans_declared':True,\n 'declaration_sha256':g['installed_source']['sha256'],'wheel_sha256':archive.sha256,'versions':versions,\n 'metadata_files':len(metadata_files),'native_artifact_access':False,'SDK_provider_input':0,'package_overlay':False}\noutput.parent.mkdir(parents=True,exist_ok=True);output.write_text(json.dumps(result,indent=2)+'\\n');output.chmod(0o600)\nprint(json.dumps({'complete':True,'source_head':revision,'assets':355,'native_access':False}))\n",
