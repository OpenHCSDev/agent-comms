      "kind": "FunctionDef",
      "source": "def _atomic_write_text(path: Path, text: str, *, fsync_parent: bool=False) -> None:\n    \"\"\"Replace a snapshot; private guarded writes also durably sync its name.\"\"\"\n    path.parent.mkdir(parents=True, exist_ok=True)\n    fd, temporary = tempfile.mkstemp(prefix=f'.{path.name}.', suffix='.tmp', dir=path.parent)\n    temporary_path = Path(temporary)\n    try:\n        with os.fdopen(fd, 'w', encoding='utf-8') as output:\n            output.write(text)\n            output.flush()\n            os.fsync(output.fileno())\n        _replace_snapshot(temporary_path, path)\n        if fsync_parent and os.name == 'posix':\n            directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))\n            try:\n                os.fsync(directory_fd)\n            finally:\n                os.close(directory_fd)\n    finally:\n        temporary_path.unlink(missing_ok=True)"
    },
